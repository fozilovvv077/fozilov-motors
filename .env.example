# ===== Admin panel =====
ADMIN_LOGIN=fozilov
ADMIN_PASSWORD=1771
# Sessiya cookie'sini imzolash uchun uzun tasodifiy satr (kamida 32 belgi)
SESSION_SECRET=bu-yerga-uzun-tasodifiy-satr-yozing-1234567890abcdef

# ===== Ma'lumotlar bazasi (Vercel -> Storage -> Neon Postgres ulanganda avtomatik qo'shiladi) =====
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ===== Rasmlar (Vercel -> Storage -> Blob ulanganda avtomatik qo'shiladi) =====
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# ===== Sayt manzili (deploydan keyin o'zingizning domeningiz) =====
NEXT_PUBLIC_SITE_URL=https://fozilov-motors.vercel.app

# ===== Telegram =====
# @BotFather'dan olingan token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Xabar boradigan chat ID (@userinfobot orqali bilib olasiz)
TELEGRAM_ADMIN_CHAT_ID=123456789
# Webhook himoyasi uchun maxfiy so'z (faqat harf, raqam, _ va -)
